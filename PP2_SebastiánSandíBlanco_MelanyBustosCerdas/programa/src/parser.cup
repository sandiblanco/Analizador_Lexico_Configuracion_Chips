/*
CURSO: Compiladores e Intérpretes
PROYECTO #2: Análisis Sintáctico
ESTUDIANTES: Sebastián Sandí Blanco y Melany Bustos Cerdas
ARCHIVO: parser.cup

OBJETIVO: Definir la gramática del lenguaje, realizar la estructura para el árbol sintáctico y la tabla de símbolos

ENTRADA: Especificaciones de terminales, no terminales, precedencias y nodos

SALIDA: Clase java con constantes enteras que representan cada token y la clase del parser para construir el árbol sintáctico y 
registrar información en la tabla de símbolos

RESTRICCIONES:
-La validación semántica se limita a errores básicos.

Código obtenido de la página oficial de Cup y adaptado para el proyecto
https://www2.cs.tum.edu/projects/cup/ */

package generados;
import java_cup.runtime.*;
import src.Nodo;

/* Palabras reservadas */
terminal String WORLD;     // world
terminal String LOCAL;     // local
terminal String GIFT;      // gift
terminal String RETURN;    // return
terminal String BREAK;     // break

terminal String DECIDE;    // decide
terminal String OF;        // of
terminal String ELSE;      // else
terminal String END;       // end
terminal String LOOP;      // loop
terminal String EXIT;      // exit
terminal String WHEN;      // when
terminal String FOR;       // for

terminal String SHOW;      // show
terminal String GET;       // get
terminal String NAVIDAD;   // navidad (main)

/* Tipos de datos */
terminal String INT;       // int
terminal String FLOAT;     // float
terminal String BOOL;      // bool
terminal String CHAR;      // char
terminal String STRING;    // string
terminal String COAL;      // coal (tipo del main)

/* Operadores */
terminal String PLUS;      // +
terminal String MINUS;     // -
terminal String MULT;      // *
terminal String DIV;       // /
terminal String DIVENT;    // //
terminal String MOD;       // %
terminal String ELEV;      // ^

terminal String INC;       // ++
terminal String DEC;       // --

terminal String LOWTHAN;        // <
terminal String LOWEQ;        // <=
terminal String GTHAN;        // >
terminal String GEQ;        // >=
terminal String EQ;        // ==
terminal String NEQ;        // !=

terminal String AND;       // @
terminal String OR;        // ~
terminal String NOT;       // Σ
terminal String ARROW;

/* Caracteres del lenguaje */
terminal String ASSIGN;    // =
terminal String LBRACE;    // ¡
terminal String RBRACE;    // !
terminal String LPAREN;    // ¿
terminal String RPAREN;    // ?
terminal String LBRACKET; // [
terminal String RBRACKET; // ]
terminal String COMMA;     // ,
terminal String ENDL;      // endl

/* Literales */
terminal Integer   INT_LITERAL;     
terminal Double    FLOAT_LITERAL;   
terminal String    STRING_LITERAL;  
terminal Character CHAR_LITERAL;  
terminal Boolean   BOOL_LITERAL;   

/* Identificador */
terminal String ID; // nombres de variables y funciones

/* No terminales */
non terminal Nodo programa, declaracionesGlobales, declaracionGlobal,funcionNavidad, tipo, listaFunciones, funcion, funcionMain, parametros, listaParametros, bloque, listaSentencias, sentencia, declaracionLocal, declaracionArreglo, arregloAsignacion, listaFilas,fila, listaValores, valoresArreglo, asignacion, sentenciaMostrar, sentenciaLeer, sentenciaReturn, sentenciaBreak, sentenciaDecide, casosDecide, casoDecide, casoElse, sentenciaLoop, salidaLoop, sentenciaFor, forIniciar, forActualizar, llamadaFuncion, argumentos, listaArgumentos, expresion, expresionLogica, terminoLogico, factorLogico, expresionRelacional, operadorRelacional, expresionAritmetica, termino, factor, unario, primario, literal;

/* Precedencias */
precedence left OR;
precedence left AND;
precedence right NOT;
precedence left EQ, NEQ, LOWTHAN, LOWEQ, GTHAN, GEQ;
precedence left PLUS, MINUS;
precedence left MULT, DIV, DIVENT, MOD;
precedence right ELEV;
precedence right UMINUS;


programa ::= declaracionesGlobales:dg listaFunciones:lf funcionMain:m
    {:
        Nodo raiz = new Nodo("PROGRAMA");
        raiz.agregarHijo(dg);
        raiz.agregarHijo(lf);
        raiz.agregarHijo(m);
        RESULT = raiz;
    :}
declaracionesGlobales ::= {: RESULT = null; :} 
			| declaracionesGlobales declaracionGlobal {: RESULT = null; :}
;


declaracionGlobal ::= WORLD tipo ID ENDL {: RESULT = null; :} 
		    | WORLD tipo ID ASSIGN expresion ENDL {: RESULT = null; :}
;

tipo ::= INT     {: RESULT = "int"; :}
       | FLOAT   {: RESULT = "float"; :}
       | BOOL    {: RESULT = "bool"; :}
       | CHAR    {: RESULT = "char"; :}
       | STRING  {: RESULT = "string"; :}
;


listaFunciones ::= {: RESULT = null; :}
                 | listaFunciones funcion {: RESULT = null; :}
;

funcion ::= GIFT tipo ID LPAREN parametros RPAREN bloque {: RESULT = null; :}
;

funcionMain ::= COAL NAVIDAD LPAREN RPAREN bloque {: RESULT = null; :}
;


parametros ::= {: RESULT = null; :}
             | listaParametros {: RESULT = null; :}
;

listaParametros ::= tipo ID {: RESULT = null; :}
                  | listaParametros COMMA tipo ID {: RESULT = null; :}
;


bloque ::= LBRACE listaSentencias RBRACE {: RESULT = null; :}
;

listaSentencias ::= {: RESULT = null; :}
                  | listaSentencias sentencia {: RESULT = null; :}
;

sentencia ::= declaracionLocal
            | declaracionArreglo
            | asignacion
            | expresion ENDL
            | sentenciaMostrar
            | sentenciaLeer
            | sentenciaReturn
            | sentenciaBreak
            | sentenciaDecide
            | sentenciaLoop
            | sentenciaFor
;

declaracionLocal ::= LOCAL tipo ID ENDL {: RESULT = null; :}
                   | LOCAL tipo ID ASSIGN expresion ENDL {: RESULT = null; :}
;

declaracionArreglo ::= tipo ID LBRACKET INT_LITERAL RBRACKET LBRACKET INT_LITERAL RBRACKET ENDL {: RESULT = null; :}
		     | tipo ID LBRACKET INT_LITERAL RBRACKET LBRACKET INT_LITERAL RBRACKET ASSIGN arregloAsignacion ENDL {: RESULT = null; :}
;


arregloAsignacion ::= LBRACE listaFilas RBRACE {: RESULT = null; :}
;


listaFilas ::= fila
             | listaFilas fila
;

fila ::= LBRACE listaValores RBRACE {: RESULT = null; :}
;

listaValores ::= valoresArreglo
               | listaValores COMMA valoresArreglo
;

valoresArreglo ::= INT_LITERAL
          | CHAR_LITERAL
;


asignacion ::= ID ASSIGN expresion ENDL {: RESULT = null; :}
             | ID LBRACKET expresion RBRACKET ASSIGN expresion ENDL {: RESULT = null; :}
             | ID LBRACKET expresion RBRACKET LBRACKET expresion RBRACKET ASSIGN expresion ENDL {: RESULT = null; :}
;

sentenciaMostrar ::= SHOW listaArgumentos ENDL {: RESULT = null; :}
;

sentenciaLeer ::= GET ID ENDL {: RESULT = null; :}
;


sentenciaDecide ::= DECIDE OF casosDecide casoElse END DECIDE ENDL {: RESULT = null; :}
;

casosDecide ::= casoDecide
              | casosDecide casoDecide
;

casoDecide ::= expresion ARROW bloque {: RESULT = null; :}
;

casoElse ::= {: RESULT = null; :}
           | ELSE ARROW bloque {: RESULT = null; :}
;

sentenciaLoop ::= LOOP listaSentencias salidaLoop END LOOP ENDL {: RESULT = null; :}
;

salidaLoop ::= EXIT WHEN expresion ENDL {: RESULT = null; :}
;

sentenciaFor ::= FOR LPAREN forIniciar ENDL expresion ENDL forActualizar RPAREN bloque {: RESULT = null; :}
;

forIniciar ::= ID ASSIGN expresion {: RESULT = null; :}
;

forActualizar ::= ID ASSIGN expresion {: RESULT = null; :}
;

sentenciaReturn ::= RETURN expresion ENDL {: RESULT = null; :}
;

sentenciaBreak ::= BREAK ENDL {: RESULT = null; :}
;

llamadaFuncion ::= ID LPAREN argumentos RPAREN
            {: RESULT = null; :}
;

argumentos ::= {: RESULT = null; :}
             | listaArgumentos {: RESULT = null; :}
;

listaArgumentos ::= expresion {: RESULT = null; :}
                  | listaArgumentos COMMA expresion {: RESULT = null; :}
;

expresion ::= expresionLogica {: RESULT = null; :}
;

expresionLogica ::= expresionLogica OR terminoLogico {: RESULT = null; :}
                  | terminoLogico {: RESULT = null; :}
;

terminoLogico ::= terminoLogico AND factorLogico {: RESULT = null; :}
                | factorLogico {: RESULT = null; :}
;

factorLogico ::= NOT factorLogico {: RESULT = null; :}
               | expresionRelacional {: RESULT = null; :}
;

expresionRelacional ::= expresionAritmetica operadorRelacional expresionAritmetica {: RESULT = null; :}
                      | expresionAritmetica {: RESULT = null; :}
;

operadorRelacional ::= LOWTHAN | LOWEQ | GTHAN | GEQ | EQ | NEQ ;

expresionAritmetica ::= expresionAritmetica PLUS termino{: RESULT = null; :}
                      | expresionAritmetica MINUS termino {: RESULT = null; :}
        	      | termino {: RESULT = null; :}
;

termino ::= termino MULT factor {: RESULT = null; :}
          | termino DIV factor {: RESULT = null; :}
          | termino DIVENT factor {: RESULT = null; :}
          | termino MOD factor {: RESULT = null; :}
          | factor {: RESULT = $1; :}
;

factor ::= factor ELEV unario {: RESULT = null; :}
         | unario {: RESULT = null; :}
;

unario ::= MINUS unario %prec UMINUS {: RESULT = null; :}
         | INC ID {: RESULT = null; :}
         | DEC ID {: RESULT = null; :}
         | primario {: RESULT = null; :}
;

primario ::= ID {: RESULT = null; :}
           | literal {: RESULT = null; :}
           | llamadaFuncion {: RESULT = null; :}
           | ID LBRACKET expresion RBRACKET LBRACKET expresion RBRACKET {: RESULT = null; :}
           | LPAREN expresion RPAREN {: RESULT = null; :}
;

literal ::= INT_LITERAL {: RESULT = null; :}
          | FLOAT_LITERAL {: RESULT = null; :}
          | STRING_LITERAL {: RESULT = null; :}
          | CHAR_LITERAL {: RESULT = null; :}
          | BOOL_LITERAL {: RESULT = null; :}
;

;
